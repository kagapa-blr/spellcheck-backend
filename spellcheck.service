[Unit]
Description=Uvicorn instance to serve Kannada Spellcheck project
After=network.target

[Service]
User=kcuser
Group=kcuser

WorkingDirectory=/Appdata/ekannada.karnataka.gov.in/kaagunitha

ExecStart=/Appdata/ekannada.karnataka.gov.in/kaagunitha/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8080

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=5
LimitNOFILE=65536

Environment="PATH=/Appdata/ekannada.karnataka.gov.in/kaagunitha/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target